# Supabase/Vercel injects POSTGRES_URL automatically after the database is connected.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Manager access
ADMIN_PIN=2468
TAX_RATE=0.13

# Recommended dedicated encryption secret for employee SIN data.
# Generate locally with: openssl rand -hex 32
EMPLOYEE_DATA_ENCRYPTION_KEY=

# Optional live customer email notifications
RESEND_API_KEY=
EMAIL_FROM="Viet Nom Nom Orders <orders@yourdomain.com>"

# Optional live SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional database tuning (V11 defaults are safe for Vercel + Supabase)
PG_POOL_MAX=2
PG_CONNECT_TIMEOUT_MS=8000
PG_QUERY_TIMEOUT_MS=15000
PG_STATEMENT_TIMEOUT_MS=15000
